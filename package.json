{
  "name": "markii",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev:https": "next dev --experimental-https --experimental-https-key ./certs/localhost-key.pem --experimental-https-cert ./certs/localhost.pem",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && pnpm check:rls",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "cross-env MARKII_ALLOW_INTEGRATION_TESTS=1 vitest run --project integration",
    "test:all": "pnpm test && pnpm test:integration",
    "check:rls": "node --env-file-if-exists=.env.local --import=tsx scripts/check-rls.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file-if-exists=.env.local --import=tsx scripts/seed.ts",
    "storage:init": "node --env-file-if-exists=.env.local --import=tsx scripts/ensure-buckets.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.23",
    "@ai-sdk/openai": "^4.0.20",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.13.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "@vercel/blob": "^2.6.1",
    "@vercel/sdk": "^1.28.8",
    "@x402/core": "^2.19.0",
    "@x402/fetch": "^2.19.0",
    "ai": "^7.0.37",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "googleapis": "^173.0.0",
    "lucide-react": "^1.26.0",
    "motion": "^12.42.2",
    "next": "16.2.11",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "schema-dts": "^2.0.0",
    "tailwind-merge": "^3.6.0",
    "viem": "^2.55.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
